# Copy to ~/.config/wiki-mcp/cf-access.env, fill in, then: chmod 600 ~/.config/wiki-mcp/cf-access.env
# Team domain from Zero Trust > Settings > Custom pages (looks like yourteam.cloudflareaccess.com)
CF_ACCESS_TEAM_DOMAIN=REPLACE_ME.cloudflareaccess.com
# Application Audience (AUD) tag: Zero Trust > Access controls > Applications > the wiki app > Overview
CF_ACCESS_AUD=REPLACE_ME
WIKI_ALLOWED_EMAILS=you@example.com
# Public hostname Cloudflare forwards (the Host header the origin will see)
WIKI_PUBLIC_HOST=wiki-mcp.REPLACE_ME.com
